---
import "../styles/viewer.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>Tiles viewer</title>
    <script is:inline>
      try {
        if (localStorage.getItem("vtiles-theme") === "light") {
          document.documentElement.dataset.theme = "light";
        }
      } catch {
        // Storage can be blocked. The page stays on the default theme.
      }
    </script>
  </head>
  <body>
    <header id="toolbar">
      <div class="brand">
        <span class="mark" aria-hidden="true">V</span>
        <h1>Tiles viewer</h1>
      </div>
      <label class="file-button" for="file">Local file</label>
      <input
        id="file"
        type="file"
        accept=".pmtiles,.mbtiles,.vtpk,.tpkx,.json,application/json"
      />
      <input
        id="url"
        type="text"
        placeholder="Load tiles from URL"
        aria-label="Load tiles from URL"
        spellcheck="false"
      />
      <button id="open" type="button">Load URL</button>
      <select id="example" aria-label="Examples">
        <option value="">Examples</option>
        <optgroup label="PMTiles">
          <option value="https://latest.protomaps.com/v4.pmtiles">Protomaps v4</option>
          <option value="https://data.source.coop/gishub/pmtiles/earth_blended.pmtiles">Natural Earth</option>
        </optgroup>
        <optgroup label="MBTiles">
          <option value="https://data.source.coop/gishub/mbtiles/vietnam.mbtiles">
            vietnam.mbtiles
          </option>
          <option value="https://data.source.coop/gishub/mbtiles/ne2.mbtiles">Natural Earth 2</option>
        </optgroup>
        <optgroup label="TileJSON">
          <option value="https://demotiles.maplibre.org/tiles/tiles.json">
            MapLibre MVT
          </option>
          <option
            value="https://basemaps.arcgis.com/arcgis/rest/services/OpenStreetMap_v2/VectorTileServer"
          >
            Esri OSM
          </option>
        </optgroup>
        <optgroup label="XYZ">
          <option
            value="https://basemaps.arcgis.com/arcgis/rest/services/World_Basemap_v2/VectorTileServer/tile/%7Bz%7D/%7By%7D/%7Bx%7D.pbf"
          >
            Esri World Basemap
          </option>
          <option
            value="https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
          >
            Esri World Imagery
          </option>
        </optgroup>
        <optgroup label="VTPK/TPKX">
          <option value="https://data.source.coop/gishub/vtpk/leon.vtpk" data-fit>leon.vtpk</option>
          <option value="s3://us-west-2.opendata.source.coop/gishub/vtpk/sanfrancisco.tpkx" data-fit>
            sanfrancisco.tpkx
          </option>
        </optgroup>
      </select>
      <button id="fit" type="button" disabled>Fit bounds</button>
      <button id="clear" type="button" disabled>Clear</button>
      <button
        id="theme"
        class="icon-button"
        type="button"
        title="Switch to light mode"
        aria-label="Switch to light mode"
      >
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12,9c1.65,0,3,1.35,3,3s-1.35,3-3,3s-3-1.35-3-3S10.35,9,12,9 M12,7c-2.76,0-5,2.24-5,5s2.24,5,5,5s5-2.24,5-5S14.76,7,12,7L12,7z M2,13l2,0c0.55,0,1-0.45,1-1s-0.45-1-1-1l-2,0c-0.55,0-1,0.45-1,1S1.45,13,2,13z M20,13l2,0c0.55,0,1-0.45,1-1s-0.45-1-1-1l-2,0c-0.55,0-1,0.45-1,1S19.45,13,20,13z M11,2v2c0,0.55,0.45,1,1,1s1-0.45,1-1V2c0-0.55-0.45-1-1-1S11,1.45,11,2z M11,20v2c0,0.55,0.45,1,1,1s1-0.45,1-1v-2c0-0.55-0.45-1-1-1C11.45,19,11,19.45,11,20z M5.99,4.58c-0.39-0.39-1.03-0.39-1.41,0c-0.39,0.39-0.39,1.03,0,1.41l1.06,1.06c0.39,0.39,1.03,0.39,1.41,0s0.39-1.03,0-1.41L5.99,4.58z M18.36,16.95c-0.39-0.39-1.03-0.39-1.41,0c-0.39,0.39-0.39,1.03,0,1.41l1.06,1.06c0.39,0.39,1.03,0.39,1.41,0c0.39-0.39,0.39-1.03,0-1.41L18.36,16.95z M19.42,5.99c0.39-0.39,0.39-1.03,0-1.41c-0.39-0.39-1.03-0.39-1.41,0l-1.06,1.06c-0.39,0.39-0.39,1.03,0,1.41s1.03,0.39,1.41,0L19.42,5.99z M7.05,18.36c0.39-0.39,0.39-1.03,0-1.41c-0.39-0.39-1.03-0.39-1.41,0l-1.06,1.06c-0.39,0.39-0.39,1.03,0,1.41s1.03,0.39,1.41,0L7.05,18.36z"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            fill="currentColor"
            d="M9.37,5.51C9.19,6.15,9.1,6.82,9.1,7.5c0,4.08,3.32,7.4,7.4,7.4c0.68,0,1.35-0.09,1.99-0.27C17.45,17.19,14.93,19,12,19c-3.86,0-7-3.14-7-7C5,9.07,6.81,6.55,9.37,5.51z M12,3c-4.97,0-9,4.03-9,9s4.03,9,9,9s9-4.03,9-9c0-0.46-0.04-0.92-0.1-1.36c-0.98,1.37-2.58,2.26-4.4,2.26c-2.98,0-5.4-2.42-5.4-5.4c0-1.81,0.89-3.42,2.26-4.4C12.92,3.04,12.46,3,12,3L12,3z"></path>
        </svg>
      </button>
      <a
        class="icon-button"
        href="https://github.com/opengeoshub/vtiles/tree/main/viewer"
        target="_blank"
        rel="noopener noreferrer"
        title="View the source on GitHub"
        aria-label="View the source on GitHub"
      >
        <svg viewBox="0 0 512 512" width="18" height="18" aria-hidden="true">
          <!-- Font Awesome Free 7.1.0 by @fontawesome - https://fontawesome.com/license/free (Icons: CC BY 4.0) Copyright 2025 Fonticons, Inc. -->
          <path
            fill="currentColor"
            d="M173.9 397.4c0 2-2.3 3.6-5.2 3.6-3.3.3-5.6-1.3-5.6-3.6 0-2 2.3-3.6 5.2-3.6 3-.3 5.6 1.3 5.6 3.6m-31.1-4.5c-.7 2 1.3 4.3 4.3 4.9 2.6 1 5.6 0 6.2-2s-1.3-4.3-4.3-5.2c-2.6-.7-5.5.3-6.2 2.3m44.2-1.7c-2.9.7-4.9 2.6-4.6 4.9.3 2 2.9 3.3 5.9 2.6 2.9-.7 4.9-2.6 4.6-4.6-.3-1.9-3-3.2-5.9-2.9M252.8 8C114.1 8 8 113.3 8 252c0 110.9 69.8 205.8 169.5 239.2 12.8 2.3 17.3-5.6 17.3-12.1 0-6.2-.3-40.4-.3-61.4 0 0-70 15-84.7-29.8 0 0-11.4-29.1-27.8-36.6 0 0-22.9-15.7 1.6-15.4 0 0 24.9 2 38.6 25.8 21.9 38.6 58.6 27.5 72.9 20.9 2.3-16 8.8-27.1 16-33.7-55.9-6.2-112.3-14.3-112.3-110.5 0-27.5 7.6-41.3 23.6-58.9-2.6-6.5-11.1-33.3 2.6-67.9 20.9-6.5 69 27 69 27 20-5.6 41.5-8.5 62.8-8.5s42.8 2.9 62.8 8.5c0 0 48.1-33.6 69-27 13.7 34.7 5.2 61.4 2.6 67.9 16 17.7 25.8 31.5 25.8 58.9 0 96.5-58.9 104.2-114.8 110.5 9.2 7.9 17 22.9 17 46.4 0 33.7-.3 75.4-.3 83.6 0 6.5 4.6 14.4 17.3 12.1C436.2 457.8 504 362.9 504 252 504 113.3 391.5 8 252.8 8M105.2 352.9c-1.3 1-1 3.3.7 5.2 1.6 1.6 3.9 2.3 5.2 1 1.3-1 1-3.3-.7-5.2-1.6-1.6-3.9-2.3-5.2-1m-10.8-8.1c-.7 1.3.3 2.9 2.3 3.9 1.6 1 3.6.7 4.3-.7.7-1.3-.3-2.9-2.3-3.9-2-.6-3.6-.3-4.3.7m32.4 35.6c-1.6 1.3-1 4.3 1.3 6.2 2.3 2.3 5.2 2.6 6.5 1 1.3-1.3.7-4.3-1.3-6.2-2.2-2.3-5.2-2.6-6.5-1m-11.4-14.7c-1.6 1-1.6 3.6 0 5.9s4.3 3.3 5.6 2.3c1.6-1.3 1.6-3.9 0-6.2-1.4-2.3-4-3.3-5.6-2"
          ></path>
        </svg>
      </a>
      <p id="status" role="status" aria-live="polite"></p>
    </header>
    <div id="stage">
      <div id="map"></div>
      <aside id="panel">
        <div class="panel-head">
          <h2>Layers</h2>
          <button id="collapse" type="button" title="Collapse layers" aria-expanded="true">
            −
          </button>
        </div>
        <div id="panel-options">
          <label class="layer" title="Show the background map">
            <input id="background" type="checkbox" />
            Background
          </label>
          <label class="layer" title="Show tile bounds">
            <input id="tile-bounds" type="checkbox" />
            Tile bounds
          </label>
        </div>
        <div id="summary"></div>
        <div id="layers"></div>
      </aside>
    </div>
    <div id="drop" hidden>Drop a tileset to open it</div>
    <script>
      import { startViewer } from "../scripts/viewer.ts";
      startViewer();
    </script>
  </body>
</html>
